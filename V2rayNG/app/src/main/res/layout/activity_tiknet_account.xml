<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/tiknet_shield"
            android:contentDescription="@string/tiknet_brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/tiknet_account_title"
            android:textColor="#E8E8E8"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/tiknet_glass_card"
            android:padding="16dp">

            <TextView
                android:id="@+id/tiknet_account_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/tiknet_sync_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/tiknet_primary_btn"
            android:text="@string/tiknet_sync_btn"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tiknet_catalog_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/tiknet_glass_card"
            android:text="@string/tiknet_catalog_btn"
            android:textColor="#E8E8E8" />

        <Button
            android:id="@+id/tiknet_logout_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/tiknet_danger_btn"
            android:text="@string/tiknet_logout_btn"
            android:textColor="#FFFFFF" />

        <ProgressBar
            android:id="@+id/tiknet_account_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="#6366F1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tiknet_account_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#9E9E9E"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
